<mujoco model="scene">
    <include file="so101.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />

        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />

        <!-- 桌子、盘子材质 -->
        <material name="table_wood" rgba="0.55 0.38 0.22 1" reflectance="0.1"/>
        <material name="plate_white" rgba="0.98 0.98 0.98 1" reflectance="0.3"/>

        <!-- 各种颜色的小方块材质 -->
        <material name="cube_red"    rgba="0.95 0.20 0.20 1"/>
        <material name="cube_orange" rgba="0.98 0.62 0.12 1"/>
        <material name="cube_yellow" rgba="0.98 0.94 0.22 1"/>
        <material name="cube_green"  rgba="0.20 0.80 0.30 1"/>
        <material name="cube_cyan"   rgba="0.20 0.85 0.85 1"/>
        <material name="cube_blue"   rgba="0.25 0.45 0.95 1"/>
        <material name="cube_purple" rgba="0.65 0.30 0.95 1"/>
        <material name="cube_pink"   rgba="0.95 0.45 0.75 1"/>
    </asset>

    <default>
        <geom friction="1.5 0.005 0.0001" />
    </default>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- 桌子静态刚体 -->
        <body name="table_base" pos="0 0 0">
            <!-- 桌面：长1.0m 宽0.6m 厚0.02m，离地高度0.4m -->
            <geom type="box" name="table_top" pos="0 0 0.4" size="0.5 0.3 0.01" material="table_wood"/>
            <!-- 四条桌腿 -->
            <geom type="box" pos="-0.47 -0.27 0.2" size="0.025 0.025 0.2" material="table_wood"/>
            <geom type="box" pos="0.47 -0.27 0.2" size="0.025 0.025 0.2" material="table_wood"/>
            <geom type="box" pos="-0.47 0.27 0.2" size="0.025 0.025 0.2" material="table_wood"/>
            <geom type="box" pos="0.47 0.27 0.2" size="0.025 0.025 0.2" material="table_wood"/>
        </body>

        <!-- 白色圆形盘子放在桌面右侧 -->
        <body name="plate_body" pos="0.22 0 0.415">
            <geom type="cylinder" size="0.12 0.006" material="plate_white"/>
            <geom type="cylinder" size="0.122 0.002" pos="0 0 0.008" material="plate_white"/>
        </body>

        <!-- 各种颜色的小方块（可自由移动，散布在桌面上） -->
        <body name="cube_red" pos="0.14 0.05 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_red"/>
        </body>
        <body name="cube_orange" pos="0.22 -0.04 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_orange"/>
        </body>
        <body name="cube_yellow" pos="0.29 0.04 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_yellow"/>
        </body>
        <body name="cube_green" pos="0.16 -0.06 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_green"/>
        </body>
        <body name="cube_cyan" pos="0.25 -0.07 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_cyan"/>
        </body>
        <body name="cube_blue" pos="0.31 -0.02 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_blue"/>
        </body>
        <body name="cube_purple" pos="0.18 0.08 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_purple"/>
        </body>
        <body name="cube_pink" pos="0.27 0.08 0.432">
            <freejoint/>
            <geom type="box" size="0.022 0.022 0.022" material="cube_pink"/>
        </body>

        <!-- 俯视相机：位于工作区正上方，朝 -Z 俯视桌面 -->
        <camera name="overhead" pos="0.20 0.0 1.0" mode="fixed" fovy="50" quat="1 0 0 0"/>
    </worldbody>
</mujoco>